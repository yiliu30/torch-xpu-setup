#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd)
ROOT_DIR=$("$SCRIPT_DIR/setup_local_xpu_userstack.sh")

export LD_LIBRARY_PATH="$ROOT_DIR/usr/lib/x86_64-linux-gnu:$ROOT_DIR/usr/local/lib:${LD_LIBRARY_PATH:-}"

exec "$ROOT_DIR/usr/bin/ocloc" "$@"
